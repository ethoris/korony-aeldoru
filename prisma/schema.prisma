// Schemat bazy danych – tabele wersji 1 z docs/gdd/13-technika.md.
// Dane stałe gry (potwory, lokacje, przedmioty, zdolności, teksty) są w src/game/data,
// nie w bazie – tu tylko stan graczy i postaci.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Konta i sesje ------------------------------------------------------

enum Role {
  PLAYER
  MODERATOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(PLAYER)
  ageConfirmed Boolean   @default(false)
  premiumUntil DateTime?
  createdAt    DateTime  @default(now())

  sessions     Session[]
  characters   Character[]
  adminActions AdminAction[] @relation("AdminActionsByUser")
  gameEvents   GameEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@map("sessions")
}

// --- Bohater --------------------------------------------------------------

enum Race {
  HUMAN
  ELF
  DWARF
  ORC
  HALFLING
  DRAGONBORN
}

enum Class {
  WARRIOR
  PALADIN
  ARCHER
  ROGUE
  MAGE
  PRIEST
}

enum Deity {
  SOLARIS
  KORGATH
  ILYRA
  VEYL
  MARDUN
  THESSA
  MORRAK
}

model Character {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server  String @default("Valmor")
  name    String
  // Znormalizowana wersja imienia (bez polskich znaków, małe litery) – unikalność
  // na serwerze ma być niezależna od wielkości liter i polskich znaków
  // (docs/gdd/01-bohater-i-konto.md: „Łukasz” blokuje „lukasz” i „ŁUKASZ”).
  nameKey String
  race    Race
  class   Class
  deity   Deity

  level      Int @default(1)
  experience Int @default(0)

  strength   Int @default(10)
  dexterity  Int @default(10)
  vitality   Int @default(10)
  intellect  Int @default(10)
  freePoints Int @default(0)

  goldPouch Int @default(0)
  fame      Int @default(1000)

  // Przybliżenie aktywności gracza (docs/gdd/00-glowny.md, "Za walkę z dawno
  // nieaktywnymi graczami nagroda spada do zera") – odświeżane przy wejściu
  // do gry (syncCharacter), nie przy każdym żądaniu.
  lastActiveAt DateTime @default(now())

  stamina          Int       @default(100)
  staminaUpdatedAt DateTime  @default(now())
  injuredUntil     DateTime?

  // Pierwszy reset statystyk od poziomu 21 jest darmowy, ale tylko raz na
  // konto postaci (docs/gdd/01-bohater-i-konto.md).
  usedFreeResetAfter20 Boolean @default(false)

  // Ochrona przed pechem (docs/gdd/08-ekwipunek.md): po 20 walkach z rzędu
  // bez rzadkiego lub lepszego przedmiotu następny przedmiot jest rzadki.
  fightsSinceRareDrop Int @default(0)

  createdAt DateTime @default(now())

  items          Item[]
  expeditions    Expedition[]
  battleReports  BattleReport[]
  bossAttempts   BossAttempt[]
  questsProgress QuestProgress[]
  titles         CharacterTitle[]
  nameHistory    NameHistoryEntry[]
  statResets     StatResetEvent[]
  goldEvents     GoldEvent[]
  itemEvents     ItemEvent[]
  gameEvents     GameEvent[]
  consumables    Consumable[]
  fortress       Fortress?
  raidsSent      Raid[]             @relation("RaidAttacker")
  raidsReceived  Raid[]             @relation("RaidDefender")
  guildLed       Guild?             @relation("GuildLeader")
  guildMembership GuildMember?
  marketOffersSold   MarketOffer[]  @relation("MarketSeller")
  marketOffersBought MarketOffer[]  @relation("MarketBuyer")

  @@unique([server, nameKey])
  @@unique([userId, server])
  @@map("characters")
}

model StatResetEvent {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  paid        Boolean
  goldCost    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([characterId, createdAt])
  @@map("stat_reset_events")
}

model NameHistoryEntry {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  oldName     String
  newName     String
  changedAt   DateTime  @default(now())
  forcedByMod Boolean   @default(false)

  @@index([characterId])
  @@map("name_history")
}

// --- Ekwipunek --------------------------------------------------------------
// Jeden przedmiot = jeden rekord; pole location mówi, gdzie leży
// (plecak / schowek / poczta łupów / założony), więc nie trzeba trzech
// identycznych tabel na to samo.

enum ItemSlot {
  WEAPON
  OFFHAND
  HELMET
  ARMOR
  GLOVES
  BOOTS
  AMULET
  RING
}

enum ItemQuality {
  COMMON
  MAGIC
  RARE
  LEGENDARY
  SET
  UNIQUE
}

enum ItemLocation {
  EQUIPPED
  BACKPACK
  STASH
  MAIL
  MARKET
}

model Item {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  templateKey String? // klucz z pliku danych, gdy to przedmiot unikalny/zestawu
  name        String
  slot        ItemSlot
  level       Int
  quality     ItemQuality
  // Klasa, dla której wylosowano przedmiot („dla kogo”, docs/gdd/08-ekwipunek.md:
  // 70% zgodne z klasą gracza, 30% losowe) – dla broni/pancerza wpływa też
  // na typ broni i mnożnik pancerza użyty przy generowaniu.
  forClass    Class

  damageMin Int?
  damageMax Int?
  armor     Int?

  traits  Json    @default("[]")
  upgrade Int     @default(0)
  // Licznik nieudanych ulepszeń z rzędu – ochrona przed pechem, +5% szansy
  // na kolejną próbę (docs/gdd/08-ekwipunek.md), zerowany po sukcesie.
  upgradeFailStreak Int     @default(0)
  rune              String?

  location ItemLocation @default(BACKPACK)
  locked   Boolean      @default(false)

  createdAt   DateTime     @default(now())
  marketOffer MarketOffer?

  @@index([characterId])
  @@map("items")
}

// --- Wyprawy i walki --------------------------------------------------------

enum ExpeditionKind {
  SCOUT // zwiad
  HUNT // polowanie
  DEEP // głęboka wyprawa
  BOSS
}

enum Tactic {
  AGGRESSIVE // Natarcie
  BALANCED // Równowaga
  DEFENSIVE // Defensywa
  RETREAT_30 // Odwrót przy 30% PŻ
}

model Expedition {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  locationKey String
  kind        ExpeditionKind
  tactic      Tactic         @default(BALANCED)
  abilities   Json           @default("[]") // do 3 wybranych kluczy zdolności
  spellElement String?       // żywioł zaklęć Maga (fire/ice/lightning) na tę wyprawę
  potions     Json           @default("[]")
  // Ziarno walk tej wyprawy – zapisane przy starcie, żeby rozliczenie
  // przy wejściu (bez procesów w tle) dało zawsze ten sam wynik.
  seed        BigInt

  startAt DateTime @default(now())
  endAt   DateTime
  settled Boolean  @default(false)

  battleReports BattleReport[]

  @@index([characterId])
  @@map("expeditions")
}

enum BattleResult {
  WIN
  LOSE
  DRAW
  RETREAT
}

model BattleReport {
  id           String      @id @default(cuid())
  characterId  String
  character    Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  expeditionId String?
  expedition   Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)

  opponentKey String
  seed        BigInt
  result      BattleResult
  turns       Json
  loot        Json         @default("[]")

  createdAt DateTime @default(now())

  @@index([characterId])
  @@index([expeditionId])
  @@map("battle_reports")
}

model BossAttempt {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  bossKey     String
  day         DateTime  @db.Date

  @@unique([characterId, bossKey, day])
  @@map("boss_attempts")
}

// --- Zadania i tytuły --------------------------------------------------------

model QuestProgress {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questKey    String
  state       String
  counter     Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, questKey])
  @@map("quests_progress")
}

model CharacterTitle {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  titleKey    String
  earnedAt    DateTime  @default(now())
  active      Boolean   @default(false)

  @@unique([characterId, titleKey])
  @@map("character_titles")
}

// --- Panel admina i dzienniki ------------------------------------------------

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AdminActionsByUser", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  reason     String
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@map("admin_actions")
}

enum ItemEventType {
  CREATED
  MOVED
  EQUIPPED
  UNEQUIPPED
  SOLD
  TRADED
  EXPIRED
  RESTORED
  DELETED
  UPGRADED
  RUNE_APPLIED
}

model ItemEvent {
  id          String        @id @default(cuid())
  itemId      String
  characterId String
  character   Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        ItemEventType
  fromState   Json?
  toState     Json?
  reason      String?
  createdAt   DateTime      @default(now())

  @@index([characterId])
  @@index([itemId])
  @@map("item_events")
}

model GoldEvent {
  id           String    @id @default(cuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  amount       Int // dodatnie = przychód, ujemne = wydatek
  balanceAfter Int
  reason       String
  createdAt    DateTime  @default(now())

  @@index([characterId])
  @@map("gold_events")
}

// --- Sklep i mikstury (docs/gdd/11-gospodarka-i-zadania.md) ------------------

model Consumable {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind        String // klucz z src/game/data/potions.ts
  quantity    Int       @default(0)

  @@unique([characterId, kind])
  @@map("consumables")
}

// --- Twierdza (wersja 3, docs/gdd/09-twierdza-i-wojna.md) ----------------

model Fortress {
  id          String    @id @default(cuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // poziomy budynków: Record<klucz z src/game/data/buildings.ts, number>
  buildingLevels Json @default("{}")

  wood      Int @default(0)
  stone     Int @default(0)
  iron      Int @default(0)
  food      Int @default(0)
  mana      Int @default(0)
  goldVault Int @default(0)

  lastProductionAt DateTime @default(now())
  // 7 dni ochrony nowych graczy przed napadami (docs/gdd/00-glowny.md); wykorzysta wersja 4.
  protectionUntil  DateTime

  createdAt DateTime @default(now())

  buildQueue BuildQueueEntry[]
  armies     Army[]

  @@map("fortresses")
}

model BuildQueueEntry {
  id          String   @id @default(cuid())
  fortressId  String
  fortress    Fortress @relation(fields: [fortressId], references: [id], onDelete: Cascade)
  building    String
  targetLevel Int
  startedAt   DateTime @default(now())
  endAt       DateTime

  @@index([fortressId])
  @@map("build_queue")
}

// klucz jednostki z src/game/data/units.ts; "w szkoleniu do" per 13-technika.md
model Army {
  id          String    @id @default(cuid())
  fortressId  String
  fortress    Fortress  @relation(fields: [fortressId], references: [id], onDelete: Cascade)
  unitKey     String
  quantity    Int       @default(0)
  trainingQuantity Int  @default(0)
  trainingEndAt    DateTime?

  @@unique([fortressId, unitKey])
  @@map("armies")
}

enum RaidResult {
  ATTACKER_WIN
  DEFENDER_WIN
}

// docs/gdd/09-twierdza-i-wojna.md, docs/gdd/13-technika.md ("raids": atakujący, cel, armia, dotarcie, wynik)
model Raid {
  id                    String      @id @default(cuid())
  attackerCharacterId   String
  attackerCharacter     Character   @relation("RaidAttacker", fields: [attackerCharacterId], references: [id], onDelete: Cascade)
  defenderCharacterId   String
  defenderCharacter     Character   @relation("RaidDefender", fields: [defenderCharacterId], references: [id], onDelete: Cascade)
  army                  Json // Record<klucz jednostki, liczba> wysłana
  arrivalAt             DateTime // "dotarcie"
  resolved              Boolean     @default(false)
  result                RaidResult?
  report                Json        @default("[]")
  createdAt             DateTime    @default(now())

  @@index([attackerCharacterId])
  @@index([defenderCharacterId])
  @@map("raids")
}

// --- Gildie (wersja 4, docs/gdd/00-glowny.md, docs/gdd/01-bohater-i-konto.md) ---

enum GuildRole {
  LEADER
  MEMBER
}

model Guild {
  id                String        @id @default(cuid())
  name              String
  nameKey           String        @unique
  tag               String
  tagKey            String        @unique
  leaderCharacterId String        @unique
  leaderCharacter   Character     @relation("GuildLeader", fields: [leaderCharacterId], references: [id])
  treasuryGold      Int           @default(0)
  nameChangedAt     DateTime?
  createdAt         DateTime      @default(now())
  members           GuildMember[]

  @@map("guilds")
}

model GuildMember {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  role        GuildRole @default(MEMBER)
  joinedAt    DateTime  @default(now())

  @@index([guildId])
  @@map("guild_members")
}

// --- Targowisko (wersja 4, docs/gdd/00-glowny.md, docs/gdd/13-technika.md) ---

// sprzedający, przedmiot lub surowiec, cena, wygasa, kupiec
model MarketOffer {
  id                 String    @id @default(cuid())
  sellerCharacterId  String
  sellerCharacter    Character @relation("MarketSeller", fields: [sellerCharacterId], references: [id], onDelete: Cascade)
  itemId             String?   @unique
  item               Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // klucz surowca z src/game/data/buildings.ts (ResourceKey), gdy to oferta surowca, nie przedmiotu
  resourceKey        String?
  quantity           Int       @default(1)
  price              Int
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  buyerCharacterId   String?
  buyerCharacter     Character? @relation("MarketBuyer", fields: [buyerCharacterId], references: [id], onDelete: SetNull)
  soldAt             DateTime?

  @@index([sellerCharacterId])
  @@map("market_offers")
}

model GameEvent {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  type        String
  details     Json       @default("{}")
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([characterId])
  @@index([type])
  @@map("game_events")
}
